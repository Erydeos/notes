model:
  version: 1
  kind: Table
  columns: []
pluginVersion: 1.0.0
views:
  - type: table
    name: Table
    filters:
      and:
        - file.inFolder("Projects/Drawing/Skills")
        - file.name != "Drawing Skills"
        - file.name != "Skills.base"
    groupBy:
      property: tier
      direction: ASC
    order:
      - file.name
      - skill level
      - class
      - requirement
      - tier
    sort:
      - property: class
        direction: ASC
      - property: skill level
        direction: ASC
    summaries:
      skill level: Sum
    columnSize:
      file.name: 182
      note.skill level: 117
      note.class: 170
      note.requirement: 379
      note.tier: 76
